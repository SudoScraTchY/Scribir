<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>SpeakerTranscript</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DiarizerPort\DiarizerPort.csproj" />
    <PackageReference Include="org.k2fsa.sherpa.onnx" Version="1.13.8" />
    <PackageReference Include="org.k2fsa.sherpa.onnx.runtime.win-x64" Version="1.13.8" />
  </ItemGroup>

  <!--
    Both Microsoft.ML.OnnxRuntime (1.30.0) and the sherpa-onnx runtime package ship a native
    `onnxruntime.dll`. Force the 1.30.0 build into the output so the newer C API (which is
    backward compatible for sherpa's older-linked calls) serves both libraries in one process.
    Verified by the app's startup smoke line + end-to-end run.
  -->
  <Target Name="ForceOrt130" AfterTargets="Build">
    <ItemGroup>
      <_Ort130 Include="$(NuGetPackageRoot)microsoft.ml.onnxruntime\1.30.0\runtimes\win-x64\native\onnxruntime.dll" />
    </ItemGroup>
    <Error Condition="!Exists('@(_Ort130)')" Text="onnxruntime 1.30.0 native not found in the NuGet cache" />
    <Copy SourceFiles="@(_Ort130)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" />
  </Target>

</Project>
