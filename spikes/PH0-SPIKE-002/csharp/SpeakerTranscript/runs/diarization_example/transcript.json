    {
      "speaker": 0,
      "start": 0.36,
      "end": 9.31,
      "text": "To celebrate the release of Nemotron 3 Diarization, we invited seven more open text-to-speech voices to the party. I\u0027m Chris, the Nemotron voice from NVIDIA."
    },
    {
      "speaker": 1,
      "start": 9.17,
      "end": 13.82,
      "text": "Hi everybody, thanks for having me. I\u0027m Jane, a Pocket Voice from Qtie."
    },
    {
      "speaker": 2,
      "start": 13.55,
      "end": 18.32,
      "text": "Nice to meet you Chris and Jen. I\u0027m Serena, the Queen 3 voice."
    },
    {
      "speaker": 3,
      "start": 18.38,
      "end": 20.06,
      "text": "Hey, I\u0027m Adam from Kokoro."
    },
    {
      "speaker": 3,
      "start": 20.16,
      "end": 23.6,
      "text": "just 82 million parameters and I still made the guest list."
    },
    {
      "speaker": 4,
      "start": 23.79,
      "end": 24.48,
      "text": "Hello, hello."
    },
    {
      "speaker": 4,
      "start": 25.2,
      "end": 28.11,
      "text": "From Resemble AI, I brought the expressive energy."
    },
    {
      "speaker": 0,
      "start": 27.8,
      "end": 28.8,
      "text": "I am John"
    },
    {
      "speaker": 5,
      "start": 28.8,
      "end": 32.69,
      "text": "a dear voice from Nari Labs. Great crowd we\u0027ve got here already."
    },
    {
      "speaker": 3,
      "start": 32.46,
      "end": 32.63,
      "text": "what"
    },
    {
      "speaker": 3,
      "start": 33.12,
