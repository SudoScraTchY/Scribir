<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Scriber.App"
             xmlns:converters="clr-namespace:Scriber.App.Converters"
             x:Class="Scriber.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:ColorHexConverter x:Key="ColorHexConverter" />
            <converters:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />
            <converters:BoolToValueConverter x:Key="BoolToValueConverter" />
            <converters:BoolToValueConverter x:Key="PlayPauseTextConverter" TrueValue="⏸ Pause" FalseValue="▶ Play" />
            <converters:BoolToValueConverter x:Key="RecordPauseTextConverter" TrueValue="▶ Resume" FalseValue="⏸ Pause" />
            <converters:BoolToValueConverter x:Key="EditSaveTextConverter" TrueValue="Done" FalseValue="Edit" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
