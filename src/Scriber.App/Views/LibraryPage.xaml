<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Scriber.App.ViewModels"
             xmlns:storage="clr-namespace:Scriber.Storage;assembly=Scriber.Storage"
             x:Class="Scriber.App.Views.LibraryPage"
             x:DataType="vm:LibraryViewModel"
             Title="Library">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Search Bar Header -->
        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F3F4F6, Dark=#1F2937}" Padding="16,12">
            <SearchBar Placeholder="Search transcripts with FTS5..."
                       Text="{Binding SearchQuery}"
                       SearchCommand="{Binding SearchCommand}"
                       MaximumWidthRequest="700" />
        </Border>

        <!-- Main Content -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsLoading}" Command="{Binding LoadCommand}">
            <ScrollView Padding="16">
                <VerticalStackLayout Spacing="16" MaximumWidthRequest="700" HorizontalOptions="Center">
                    
                    <!-- Search Results Section -->
                    <VerticalStackLayout IsVisible="{Binding IsSearching}" Spacing="8">
                        <Label Text="Search Results" FontSize="16" FontAttributes="Bold" TextColor="#2563EB" />
                        
                        <CollectionView ItemsSource="{Binding SearchResults}">
                            <CollectionView.EmptyView>
                                <Label Text="No matching segments found." TextColor="#6B7280" HorizontalOptions="Center" Margin="0,20" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="storage:SearchResult">
                                    <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}" Margin="0,4" Padding="12">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=OpenTranscriptCommand}" CommandParameter="{Binding TranscriptId}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="4">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Grid.Column="0" Text="{Binding TranscriptTitle}" FontAttributes="Bold" FontSize="14" />
                                                <Label Grid.Column="1" Text="{Binding Start, StringFormat='{0:mm\\:ss}'}" TextColor="#2563EB" FontSize="12" />
                                            </Grid>
                                            <Label Text="{Binding Text}" FontSize="13" TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- All Transcripts Section -->
                    <VerticalStackLayout IsVisible="{Binding IsSearching, Converter={StaticResource InvertedBoolConverter}}" Spacing="12">
                        <Label Text="All Transcripts" FontSize="18" FontAttributes="Bold" />

                        <CollectionView ItemsSource="{Binding Transcripts}">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Spacing="8" Margin="0,40" HorizontalOptions="Center">
                                    <Label Text="No transcripts saved yet." FontSize="16" TextColor="#6B7280" HorizontalTextAlignment="Center" />
                                    <Label Text="Record or import audio in the Transcribe tab." FontSize="13" TextColor="#9CA3AF" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="storage:TranscriptSummary">
                                    <Border StrokeThickness="1" Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F2937}" Margin="0,6" Padding="16">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="10" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=OpenTranscriptCommand}" CommandParameter="{Binding Id}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="6">
                                            <Label Grid.Column="0" Grid.Row="0" Text="{Binding Title}" FontSize="16" FontAttributes="Bold" />
                                            <Label Grid.Column="1" Grid.Row="0" Text="{Binding Duration, StringFormat='{0:hh\\:mm\\:ss}'}" FontSize="13" TextColor="#6B7280" HorizontalOptions="End" />

                                            <HorizontalStackLayout Grid.Column="0" Grid.Row="1" Spacing="12">
                                                <Label Text="{Binding CreatedAt, StringFormat='{0:MMM dd, yyyy}'}" FontSize="12" TextColor="#9CA3AF" />
                                                <Label Text="•" TextColor="#D1D5DB" />
                                                <Label Text="{Binding SpeakerCount, StringFormat='{0} speakers'}" FontSize="12" TextColor="#9CA3AF" />
                                                <Label Text="•" TextColor="#D1D5DB" />
                                                <Label Text="{Binding LanguageCode, StringFormat='lang: {0}'}" FontSize="12" TextColor="#9CA3AF" />
                                            </HorizontalStackLayout>

                                            <Button Grid.Column="1" Grid.Row="1" Text="Delete" TextColor="#DC2626" BackgroundColor="Transparent" FontSize="12" Padding="8,4"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=DeleteTranscriptCommand}" CommandParameter="{Binding Id}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
