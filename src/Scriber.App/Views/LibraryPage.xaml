<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Scriber.App.ViewModels"
             xmlns:storage="clr-namespace:Scriber.Storage;assembly=Scriber.Storage"
             x:Class="Scriber.App.Views.LibraryPage"
             x:DataType="vm:LibraryViewModel"
             Title="Library"
             BackgroundColor="{AppThemeBinding Light={StaticResource Gray50}, Dark={StaticResource Gray950}}">

    <Grid RowDefinitions="Auto, *">
        
        <!-- Search Header Bar -->
        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}" Padding="16,12">
            <Border.Shadow>
                <Shadow Brush="Black" Offset="0,2" Radius="4" Opacity="0.05" />
            </Border.Shadow>
            <SearchBar Placeholder="Search across all transcripts..."
                       Text="{Binding SearchQuery}"
                       SearchCommand="{Binding SearchCommand}"
                       MaximumWidthRequest="680"
                       BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}"
                       CancelButtonColor="{StaticResource Primary}" />
        </Border>

        <!-- Main Content -->
        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsLoading}" Command="{Binding LoadCommand}" RefreshColor="{StaticResource Primary}">
            <ScrollView Padding="16">
                <VerticalStackLayout Spacing="16" MaximumWidthRequest="680" HorizontalOptions="Center">
                    
                    <!-- Search Results Section -->
                    <VerticalStackLayout IsVisible="{Binding IsSearching}" Spacing="10">
                        <Label Text="Search Results" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                        
                        <CollectionView ItemsSource="{Binding SearchResults}">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Spacing="8" Margin="0,30" HorizontalOptions="Center">
                                    <Label Text="🔍" FontSize="32" HorizontalTextAlignment="Center" />
                                    <Label Text="No matching segments found." TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="storage:SearchResult">
                                    <Border StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                            Margin="0,4" Padding="14">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=OpenTranscriptCommand}" CommandParameter="{Binding TranscriptId}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Grid.Column="0" Text="{Binding TranscriptTitle}" FontAttributes="Bold" FontSize="14" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                                <Border Grid.Column="1" BackgroundColor="{StaticResource Secondary}" Padding="6,2">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="6" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Start, StringFormat='{0:mm\\:ss}'}" TextColor="{StaticResource Primary}" FontSize="11" FontAttributes="Bold" />
                                                </Border>
                                            </Grid>
                                            <Label Text="{Binding Text}" FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray300}}" LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                    <!-- All Transcripts Section -->
                    <VerticalStackLayout IsVisible="{Binding IsSearching, Converter={StaticResource InvertedBoolConverter}}" Spacing="12">
                        <Label Text="Saved Transcripts" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                        <CollectionView ItemsSource="{Binding Transcripts}">
                            <CollectionView.EmptyView>
                                <VerticalStackLayout Spacing="10" Margin="0,60" HorizontalOptions="Center">
                                    <Label Text="🎙️" FontSize="44" HorizontalTextAlignment="Center" />
                                    <Label Text="No transcripts saved yet" FontSize="17" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" HorizontalTextAlignment="Center" />
                                    <Label Text="Record live audio or import files in the Transcribe tab." FontSize="13" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="storage:TranscriptSummary">
                                    <Border StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray800}}"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                            Margin="0,5" Padding="16">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=OpenTranscriptCommand}" CommandParameter="{Binding Id}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto" RowSpacing="10">
                                            
                                            <!-- Title & Duration Badge -->
                                            <Label Grid.Column="0" Grid.Row="0" Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" VerticalOptions="Center" />
                                            
                                            <Border Grid.Column="1" Grid.Row="0" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}" Padding="8,3" HorizontalOptions="End" VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="6" />
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Duration, StringFormat='{0:hh\\:mm\\:ss}'}" FontSize="12" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                            </Border>

                                            <!-- Metadata Chips -->
                                            <HorizontalStackLayout Grid.Column="0" Grid.Row="1" Spacing="8" VerticalOptions="Center">
                                                <Label Text="{Binding CreatedAt, StringFormat='{0:MMM dd, yyyy}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                                <Label Text="•" TextColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                                                <Label Text="{Binding SpeakerCount, StringFormat='{0} spk'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                                <Label Text="•" TextColor="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}" />
                                                <Label Text="{Binding LanguageCode, StringFormat='lang: {0}'}" FontSize="12" TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                                            </HorizontalStackLayout>

                                            <!-- Delete Action Button -->
                                            <Button Grid.Column="1" Grid.Row="1"
                                                    Text="Delete"
                                                    TextColor="{StaticResource Danger}"
                                                    BackgroundColor="Transparent"
                                                    FontSize="12"
                                                    Padding="8,4"
                                                    HeightRequest="32"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LibraryViewModel}}, Path=DeleteTranscriptCommand}"
                                                    CommandParameter="{Binding Id}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
